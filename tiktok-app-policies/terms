<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex, nofollow" />
<title>Terms of Service</title>
<style>
  :root{
    --bg:#0a0d12;
    --card:rgba(255,255,255,.035);
    --border:rgba(255,255,255,.09);
    --text:#e9eef6;
    --muted:#8e9bad;
    --accent:#8b5cf6;
    --accent2:#22d3ee;
    --glow1:rgba(139,92,246,.22);
    --glow2:rgba(34,211,238,.16);
    --radius:22px;
  }

  @media (prefers-color-scheme: light){
    :root{
      --bg:#f4f6f9;
      --card:rgba(255,255,255,.92);
      --border:rgba(15,23,42,.09);
      --text:#111827;
      --muted:#5b6678;
      --glow1:rgba(139,92,246,.16);
      --glow2:rgba(34,211,238,.14);
    }
  }

  *{box-sizing:border-box}

  body{
    margin:0;
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:56px 20px;
    background:var(--bg);
    color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,Helvetica,Arial,sans-serif;
    font-size:16px;
    line-height:1.7;
    -webkit-font-smoothing:antialiased;
    position:relative;
    overflow-x:hidden;
  }

  body::before,
  body::after{
    content:"";
    position:fixed;
    border-radius:50%;
    filter:blur(90px);
    pointer-events:none;
    z-index:0;
  }
  body::before{width:620px;height:620px;background:var(--glow1);top:-240px;left:-180px}
  body::after{width:560px;height:560px;background:var(--glow2);bottom:-260px;right:-160px}

  .card{
    position:relative;
    z-index:1;
    width:100%;
    max-width:760px;
    padding:clamp(28px,5vw,56px);
    background:var(--card);
    border:1px solid var(--border);
    border-radius:var(--radius);
    backdrop-filter:blur(18px) saturate(140%);
    -webkit-backdrop-filter:blur(18px) saturate(140%);
    box-shadow:
      0 30px 80px -30px rgba(0,0,0,.5),
      inset 0 1px 0 rgba(255,255,255,.06);
    animation:rise .8s cubic-bezier(.2,.7,.3,1) both;
  }

  @keyframes rise{
    from{opacity:0;transform:translateY(18px)}
    to{opacity:1;transform:none}
  }

  .badge{
    display:inline-flex;
    align-items:center;
    gap:9px;
    padding:6px 14px;
    margin-bottom:24px;
    font-size:11.5px;
    font-weight:600;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:var(--muted);
    border:1px solid var(--border);
    border-radius:999px;
  }
  .badge::before{
    content:"";
    width:6px;height:6px;
    border-radius:50%;
    background:linear-gradient(135deg,var(--accent),var(--accent2));
    box-shadow:0 0 12px var(--accent);
  }

  h1{
    margin:0 0 14px;
    font-family:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;
    font-weight:600;
    font-size:clamp(30px,5vw,44px);
    line-height:1.12;
    letter-spacing:-.02em;
  }

  .lede{
    margin:0;
    max-width:56ch;
    font-size:1.05rem;
    color:var(--muted);
  }

  .callout{
    margin:34px 0 6px;
    padding:18px 22px;
    border:1px solid var(--border);
    border-left:3px solid transparent;
    border-image:linear-gradient(180deg,var(--accent),var(--accent2)) 1;
    border-radius:0 14px 14px 0;
    background:linear-gradient(90deg,rgba(139,92,246,.08),transparent 70%);
    color:var(--text);
    font-size:.97rem;
  }
  .callout strong{font-weight:650}

  .section{
    padding:26px 0;
    border-top:1px solid var(--border);
  }
  .section:first-of-type{border-top:0;padding-top:30px}
  .section:last-of-type{padding-bottom:22px}

  h2{
    display:flex;
    align-items:baseline;
    gap:12px;
    margin:0 0 8px;
    font-size:1rem;
    font-weight:650;
    letter-spacing:.005em;
  }
  h2 .num{
    font-size:.78rem;
    font-weight:700;
    letter-spacing:.1em;
    font-variant-numeric:tabular-nums;
    background:linear-gradient(135deg,var(--accent),var(--accent2));
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
  }

  .section p{
    margin:0;
    color:var(--muted);
  }
  .section p strong{color:var(--text);font-weight:600}

  footer{
    display:flex;
    flex-wrap:wrap;
    gap:8px 20px;
    justify-content:space-between;
    margin-top:10px;
    padding-top:26px;
    border-top:1px solid var(--border);
    font-size:.85rem;
    color:var(--muted);
  }

  ::selection{background:rgba(139,92,246,.35);color:var(--text)}

  @media (max-width:520px){
    body{padding:28px 14px;align-items:flex-start}
    .card{border-radius:18px}
  }

  @media (prefers-reduced-motion:reduce){
    .card{animation:none}
  }
</style>
</head>
<body>

<main class="card">
  <span class="badge">Legal</span>

  <h1>Terms of Service</h1>
  <p class="lede">
    This is a private personal tool used solely by its developer to manage their own TikTok content.
  </p>

  <div class="callout">
    <strong>No third-party users are involved.</strong>
    Use is restricted to the app owner only.
  </div>

  <section class="section">
    <h2><span class="num">01</span> Purpose</h2>
    <p>
      This application is a <strong>private personal tool</strong> operated by its developer for the
      sole purpose of managing their own TikTok content.
    </p>
  </section>

  <section class="section">
    <h2><span class="num">02</span> No Third-Party Users</h2>
    <p>
      No third-party users are involved. The tool is not distributed, licensed, or made available
      to the public in any form.
    </p>
  </section>

  <section class="section">
    <h2><span class="num">03</span> Restricted Access</h2>
    <p>
      Use is restricted to the <strong>app owner only</strong>. There is no public sign-up,
      no external account access, and no shared usage of any kind.
    </p>
  </section>

  <section class="section">
    <h2><span class="num">04</span> Changes</h2>
    <p>
      As a personal tool, these terms may be updated or amended at any time without prior notice.
    </p>
  </section>

  <footer>
    <span>Last updated: <span id="date"></span></span>
    <span>© <span id="year"></span> — Owner-operated</span>
  </footer>
</main>

<script>
  const now = new Date();
  document.getElementById('date').textContent = now.toLocaleDateString('en-US', {
    year: 'numeric', month: 'long', day: 'numeric'
  });
  document.getElementById('year').textContent = now.getFullYear();
</script>

</body>
</html>
